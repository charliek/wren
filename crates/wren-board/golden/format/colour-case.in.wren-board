schema = 1

[node.a]
text = "Upper-case hex"
kind = "shape"
at = [0, 0]
size = [120, 60]
style.color = "#3A7BD5"
z = "V01"

[node.b]
text = "Not a colour"
kind = "shape"
at = [0, 120]
size = [120, 60]
style.color = "#ABC"
z = "V02"

[edge.e]
kind = "edge"
from = { node = "a" }
to = { node = "b" }
style.color = "#FF00Aa"
z = "V03"

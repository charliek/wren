schema = 1

[node.a]
text = "A"
kind = "shape"
at = [0, 0]
ext.tool.k = "v"
size = [120, 60]
style.color = "blue"
z = "V01"

[node.b]
text = "B"
kind = "shape"
at = [0, 120]
size = [120, 60]
style.color = "green"
style.fill = "none"
z = "V02"

[edge.e]
kind = "edge"
from = { node = "a", side = "bottom" }
to = { node = "b" }
labels = [
  { at = 250, text = "first" },
  { text = "second" },
]
z = "V03"
